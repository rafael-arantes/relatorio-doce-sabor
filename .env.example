# ---------------------------------------------------------------------------
# excel-mcp configuration
# Copy to .env and fill in. Every variable is documented in README.md.
# ---------------------------------------------------------------------------

# SOURCE — how to reach the workbook:
#   "auto"           = local if EXCEL_LOCAL_FILE/EXCEL_XLSX_PATH is set, else graph
#   "graph"          = the Graph *workbook* API (live cell values; needs a work/school
#                      account — documented as unsupported for personal Microsoft
#                      accounts and for app-only tokens)
#   "graph_download" = resolve the file via Graph, download the .xlsx, parse locally.
#                      Use this for personal accounts or EXCEL_AUTH=client_secret.
#   "local"          = a .xlsx on disk (or downloaded from a share link)
EXCEL_SOURCE=auto

# When EXCEL_SOURCE=graph and the workbook API is refused (403/400/5xx), download the
# file once and read it locally instead of failing. Set to 0 to surface the error.
EXCEL_GRAPH_FALLBACK=1

# ---------------------------------------------------------------------------
# Which workbook to read (GRAPH mode) — set EXACTLY ONE of the three.
# ---------------------------------------------------------------------------
# 1) Drive path of the file ("/Documentos/PLANILHA.xlsx" for OneDrive,
#    "/Shared Documents/PLANILHA.xlsx" style paths for SharePoint drives).
# EXCEL_WORKBOOK_PATH=/Documentos/PLANILHA.xlsx

# 2) Explicit drive + item ids (get them from `excel_workbook_info` output or
#    the Graph explorer). Most precise option.
# EXCEL_DRIVE_ID=
# EXCEL_ITEM_ID=

# 3) A OneDrive/SharePoint share link (works in BOTH graph and local mode).
#    In local mode the file is downloaded and parsed offline with exceljs.
# EXCEL_SHARE_URL=https://1drv.ms/x/s!AbCdEf...
# EXCEL_SHARE_URL=https://seu-tenant.sharepoint.com/:x:/g/personal/user/Doc?e=abc

# ---------------------------------------------------------------------------
# Which workbook to read (LOCAL mode)
# ---------------------------------------------------------------------------
# EXCEL_LOCAL_FILE=/Volumes/Storage/www/doce-sabor/PLANILHA.xlsx
# Alias kept for convenience:
# EXCEL_XLSX_PATH=

# ---------------------------------------------------------------------------
# AUTH (GRAPH modes) — EXCEL_AUTH=device_code (delegated) | client_secret (app-only)
# ---------------------------------------------------------------------------
EXCEL_AUTH=device_code

# Delegated / device-code flow. Tenant "common" works for personal (outlook.com,
# hotmail.com, live.com) AND work-or-school accounts.
EXCEL_TENANT_ID=common
# Application (client) id of your Azure app registration.
# Leave blank to use the Microsoft first-party "Graph Command Line Tools" public
# client id, which needs no app registration but must be consented by the user.
# EXCEL_CLIENT_ID=
EXCEL_SCOPES=offline_access Files.Read.All
# Para arquivos em OneDrive pessoal, deixe somente offline_access + Files.Read.All
# (ou Files.Read). Sites.Read.All é para SharePoint/corporativo e quebra o login
# de contas pessoais. Para um arquivo corporativo em SharePoint, use:
# EXCEL_SCOPES=offline_access Files.Read.All Sites.Read.All

# App-only / client-credentials flow. Requires your own Azure app registration with
# the *application* permission Files.Read.All granted by an admin. The Graph workbook
# API rejects app-only tokens, so pair this with EXCEL_SOURCE=graph_download.
# EXCEL_CLIENT_SECRET=

# Where the refresh/access token cache is written (chmod 600).
EXCEL_TOKEN_CACHE=.tokens/graph.json

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Max rows returned by a single read before truncation kicks in.
EXCEL_MAX_ROWS=5000
EXCEL_MAX_CELLS=200000
# 1 = include a small preview in logs on stderr
EXCEL_DEBUG=0
